# ─────────────────────────────────────────────────────────────
# Modavella Catalog Importer — configuration
# Copy this file to ".env" and adjust. The .env file is git-ignored.
# ALL values are optional; sensible defaults are used when omitted.
# There are NO API keys required for the SEO engine.
# ─────────────────────────────────────────────────────────────

# Your store name — used in SEO titles/descriptions and branding.
SHOP_NAME=Modavella

# Your store's primary language (nl | en). Affects SEO copy templates.
SHOP_LOCALE=nl

# Currency used in structured data (JSON-LD). ISO 4217, e.g. EUR, USD, GBP.
SHOP_CURRENCY=EUR

# Polite scraping controls (be a good citizen; avoid hammering a store).
# Delay between requests in milliseconds.
SCRAPE_DELAY_MS=600
# Max parallel requests when fetching per-collection product lists.
SCRAPE_CONCURRENCY=3
# Max retries per request on transient failures (429/5xx/network).
SCRAPE_MAX_RETRIES=4
# Custom User-Agent string sent with every request.
SCRAPE_USER_AGENT=ModavellaCatalogImporter/1.0 (+contact: you@modavella.nl)

# Optional trust signals injected into enhanced descriptions & meta.
# Leave blank to omit. Only set these to TRUE claims about YOUR store.
TRUST_SHIPPING=Gratis verzending vanaf €50
TRUST_RETURNS=30 dagen gratis retour
TRUST_SERVICE=Klantenservice op werkdagen binnen 24u
